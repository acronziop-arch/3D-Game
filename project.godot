; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Everstead"
config/description="Низкополигональный строительный симулятор с бесконечным миром."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.9607843, 0.9529412, 0.9372549, 1)
boot_splash/show_image=false

[audio]

driver/driver.web="Dummy"

[autoload]

Platform="*res://scripts/autoload/platform.gd"
Controls="*res://scripts/autoload/controls.gd"
Settings="*res://scripts/autoload/settings.gd"
GameMode="*res://scripts/autoload/game_mode.gd"
GameData="*res://scripts/autoload/game_data.gd"
WorldState="*res://scripts/autoload/world_state.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Crafting="*res://scripts/autoload/crafting.gd"
Weather="*res://scripts/autoload/weather.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/ios/hide_home_indicator=true
window/ios/hide_status_bar=true
window/ios/suppress_ui_gesture=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method.android="mobile"
renderer/rendering_method.ios="gl_compatibility"
renderer/rendering_method.pc="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=1
anti_aliasing/quality/msaa_3d.web=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=1
environment/defaults/default_clear_color=Color(0.96, 0.95, 0.94, 1)

[shader_globals]

wind_dir={
"type": "vec2",
"value": Vector2(1, 0.35)
}
wind_strength={
"type": "float",
"value": 0.25
}
wetness={
"type": "float",
"value": 0.0
}
snow_cover={
"type": "float",
"value": 0.0
}
leaf_amount={
"type": "float",
"value": 1.0
}
autumn={
"type": "float",
"value": 0.0
}
spring={
"type": "float",
"value": 0.0
}
night={
"type": "float",
"value": 0.0
}
rain={
"type": "float",
"value": 0.0
}
water_level={
"type": "float",
"value": 0.0
}
frost={
"type": "float",
"value": 0.0
}
interiors={
"type": "float",
"value": 1.0
}
ice={
"type": "float",
"value": 0.0
}
snowfall={
"type": "float",
"value": 0.0
}
wind_phase={
"type": "float",
"value": 0.0
}
wind_drift={
"type": "vec2",
"value": Vector2(0, 0)
}
texture_detail={
"type": "float",
"value": 1.0
}
